# Copy to .env and fill in values for local overrides (optional).
# Without .env, local dev uses SQLite, DEBUG=True, ALLOWED_HOSTS=*, and open CORS.

DEBUG=True
SECRET_KEY=change-me-generate-a-long-random-value
# Leave unset in DEBUG to allow LAN phones by IP. For production, set explicitly.
# ALLOWED_HOSTS=127.0.0.1,localhost,your-app.onrender.com
# DATABASE_URL=postgres://user:pass@host/dbname
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# FRONTEND_BASE_URL=https://your-frontend.vercel.app
# SERVE_MEDIA=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=MacFiesta Pro <noreply@yourdomain.com>
# COMMITTEE_SEED_PASSWORD=use-a-strong-temporary-password
