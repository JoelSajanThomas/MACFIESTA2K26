# =============================================================================
# MacFiesta Pro — backend environment template
# Copy to `.env` and fill values. NEVER commit a real `.env`.
# =============================================================================

# --- Required in production (DEBUG=False) ---
DEBUG=False
SECRET_KEY=change-me-generate-a-long-random-value
ALLOWED_HOSTS=your-api.example.com,www.your-api.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Frontend origins (no trailing slash)
# To allow all origins (e.g., student access from anywhere or mobile apps):
CORS_ALLOW_ALL_ORIGINS=True
# Or specify comma-separated origins:
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
FRONTEND_BASE_URL=https://your-frontend.example.com

# --- SMTP (required for OTP password reset / emails) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=MacFiesta 2026 <noreply@example.com>

# --- Payment details (public registration display via /api/public/config/) ---
PAYMENT_ACCOUNT_NAME=MacFiesta / MACFAST
PAYMENT_UPI_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_IFSC=
PAYMENT_INSTRUCTIONS=Pay the total amount to the MacFiesta fest account. Keep the UPI/bank receipt - the desk will verify payment against your registration number.
# Static GPay/UPI QR image (frontend public path or absolute URL)
# PAYMENT_QR_IMAGE_URL=/assets/payments/gpay-test-qr.png

# --- Registration add-on fees (INR) ---
FOOD_PACKAGE_FEE=150.00
ACCOMMODATION_FEE_PER_PERSON=300.00
TRANSPORT_ASSIST_FEE=100.00

# --- QR / pass signing ---
QR_IMAGE_API_URL=https://api.qrserver.com/v1/create-qr-code/
REGISTRATION_SIGNER_SALT=change-me-unique-per-deploy
REGISTRATION_PASS_MAX_AGE_DAYS=60

# --- Public contact (optional; CMS site-settings can also set these) ---
CONTACT_EMAIL=
CONTACT_PHONE=
REGISTRATION_HELP_EMAIL=
REGISTRATION_HELP_PHONE=
OFFICIAL_WEBSITE=
INSTAGRAM_URL=
YOUTUBE_URL=
FACEBOOK_URL=

# --- Committee desk seed credentials (REQUIRED to seed desks) ---
DESK_USERNAME_TEMPLATE=macfiesta{committee}admin
DESK_EMAIL_DOMAIN=macfiesta.local
DESK_PASSWORD_TEMPLATE=
COMMITTEE_SEED_PASSWORD=

# --- Optional ---
# SERVE_MEDIA=True
# SECURE_SSL_REDIRECT=True

# =============================================================================
# Local development
# =============================================================================
# DEBUG=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
