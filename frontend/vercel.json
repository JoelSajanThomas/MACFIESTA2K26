{
  "headers": [
    {
      "source": "/(assets|MARVEL|songs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://macfiesta-api.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://macfiesta-api.onrender.com/media/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
