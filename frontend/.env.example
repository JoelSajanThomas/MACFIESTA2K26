# =============================================================================
# MacFiesta Pro — frontend environment template
# Copy to `.env` / `.env.local`. NEVER put real desk/SMTP passwords in VITE_*.
# Vite only exposes variables prefixed with VITE_ (they ship to the browser).
# =============================================================================

# Leave unset for `npm run dev` — Vite proxies /api and /media to Django.
# Production / Capacitor / staging builds MUST set:
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api

# --- Payment / fees fallbacks (backend /.env + /api/public/config/ wins) ---
VITE_PAYMENT_ACCOUNT_NAME=MacFiesta / MACFAST
VITE_PAYMENT_UPI_ID=
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_IFSC=
VITE_PAYMENT_INSTRUCTIONS=Pay the total amount to the MacFiesta fest account. Keep the UPI/bank receipt - the desk will verify payment against your registration number.
VITE_FEE_FOOD_PACKAGE=150
VITE_FEE_ACCOMMODATION=300
VITE_FEE_TRANSPORT=100
VITE_QR_API_URL=https://api.qrserver.com/v1/create-qr-code/

# Optional: static GPay/UPI QR image path (e.g. /assets/payments/gpay-test-qr.png)
VITE_PAYMENT_QR_IMAGE_URL=

# --- Public contact / social (no secrets — shown on the site) ---
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_REGISTRATION_HELP_EMAIL=
VITE_REGISTRATION_HELP_PHONE=
VITE_OFFICIAL_WEBSITE=https://macfiesta.macfast.org/
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=
VITE_VENUE=MACFAST Campus, Thiruvalla
VITE_LOCATION=Pathanamthitta, Kerala, India
VITE_REGISTRATION_OPENS=2026-08-01
VITE_FEST_START=2026-09-24
VITE_FEST_END=2026-09-25

# Optional username display template (passwords must NEVER be VITE_*)
# VITE_DESK_USERNAME_TEMPLATE=macfiesta{committee}admin

