# Production / staging frontend build — set in the host CI or Vercel/Netlify env.
# Rebuild after changing VITE_* values (embedded at build time).
# NEVER put desk passwords, SMTP passwords, or SECRET_KEY in VITE_* vars.

VITE_API_BASE_URL=https://your-real-backend-domain/api

VITE_PAYMENT_ACCOUNT_NAME=MacFiesta / MACFAST
VITE_PAYMENT_UPI_ID=
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_IFSC=
VITE_FEE_FOOD_PACKAGE=150
VITE_FEE_ACCOMMODATION=300
VITE_FEE_TRANSPORT=100
VITE_QR_API_URL=https://api.qrserver.com/v1/create-qr-code/

VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_OFFICIAL_WEBSITE=https://macfiesta.macfast.org/
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=
VITE_FEST_START=2026-09-24
VITE_FEST_END=2026-09-25
